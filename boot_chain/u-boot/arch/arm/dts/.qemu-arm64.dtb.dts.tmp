/ {
 smbios {
  compatible = "u-boot,sysinfo-smbios";

  smbios {
   system {
    manufacturer = "emulation";
    product = "qemu-arm";
    version = "";
    serial = "";
    wakeup-type = <2>;
    sku = "";
    family = "armv8";
   };

   baseboard {
    manufacturer = "emulation";
    product = "qemu-arm";
    version = "";
    serial = "";
    asset-tag = "";
    chassis-location = "";
    feature-flags = <1>;
    board-type = <10>;
   };

   chassis {
    manufacturer = "emulation";
    version = "";
    serial = "";
    asset-tag = "";
    chassis-type = <3>;
    bootup-state = <3>;
    power-supply-state = <3>;
    thermal-state = <3>;
    security-status = <3>;
    oem-defined = <0>;
    height = <0>;
    number-of-power-cords = <0>;
   };

   processor {
    version = "";
    processor-type = <3>;
    processor-status = <1>;
    upgrade = <6>;
    family = <0xfe>;
    family2 = <257>;
    socket-design = "";
    serial = "";
    asset-tag = "";
    part-number = "";
   };

   cache {
    l1-cache {
     socket-design = "";
     config = <(0 |
         0x80 |
         0x100)>;
    };

    l2-cache {
     socket-design = "";
     config = <(1 |
         0x80 |
         0x100)>;
    };
   };
  };
 };
};
